// filterToggleButton.textContent = newFilterStatus % 2 ? 'Off' : 'On';

// }

// } catch (error) {

// console.error('Error updating filter status:', error);

// }

// });

// }

});

// Add this after DOMContentLoaded

async function fetchInitialStates() {

try {

const fanResponse = await fetch('/api/fan-state');

const fanData = await fanResponse.json();

fanState = fanData.fanState;

document.getElementById("fan-btn").innerText = fanState ? 'On' : 'Off';

const solenoidResponse = await fetch('/api/solenoid-state');

const solenoidData = await solenoidResponse.json();

solenoidState = solenoidData.solenoidState;

document.getElementById("solenoid-btn").innerText = solenoidState ? 'On' : 'Off';

} catch (error) {

console.error("Failed to fetch initial states:", error);

}

}


fetchInitialStates();

</script>

</body>


</html> 