<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CO₂ Dashboard Login</title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="stylesheet" href="/style.css">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
</head>

<body>
    <main>
        <h1>Toggle Fan</h1>
        <button id="fan-btn" class="filter-button" >Toggle Fan</button>

        <h1>Toggle Solenoid</h1>
        <button id="solenoid-btn" class="filter-button" >Toggle Solenoid</button>
    </main>
  <script>
    let ledState
    document.addEventListener("DOMContentLoaded", function() {
        ledState = JSON.parse('<%- JSON.stringify(ledState) %>')
        console.log(ledState)
    })
    document.getElementById('fan-btn').addEventListener('click', ()=>{
        if (ledState){
            ledState = false
        }else if (!ledState){
            ledState = true
        }
        const response = fetch('http://localhost:3000/toggle-led',{
            method:"POST",
            headers:{
                'Content-Type': 'application/json'                
            },
            body: JSON.stringify({
                ledState: ledState
            })
        })
    })
  </script>
</body>

</html>